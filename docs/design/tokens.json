{
  "$description": "Brew & Co design tokens. tokens.css is the source of truth for code; this file mirrors it for design tools and docs.",
  "color": {
    "crema": { "50": "#fff1e9", "300": "#ffb48a", "500": "#ff7a3d", "700": "#c74a12" },
    "cup": "#ffffff",
    "mist": "#e9eaec",
    "mistDeep": "#d5d7db",
    "lid": "#2b2b2d",
    "ink": "#161617",
    "inkSoft": "#55575c",
    "blush": "#d9a99b",
    "blush50": "#f6e9e5",
    "success": "#1f7a4d",
    "warning": "#8a5a00",
    "danger": "#b3261e"
  },
  "colorDark": {
    "background": "#121213",
    "surface": "#1d1d1f",
    "foreground": "#f3f3f1",
    "muted": "#a9abb0",
    "border": "#2f3033",
    "accentText": "#ff9a67"
  },
  "font": {
    "display": "Outfit",
    "sans": "Hanken Grotesk",
    "marker": "Permanent Marker"
  },
  "fontSize": {
    "caption": "0.8125rem",
    "body": "1rem",
    "lead": "1.25rem",
    "h3": "1.5rem",
    "h2": "clamp(2rem, 1.4rem + 2.4vw, 3.25rem)",
    "h1": "clamp(2.75rem, 1.6rem + 5vw, 5.5rem)",
    "mega": "clamp(4.5rem, 0.2rem + 24vw, 22rem)"
  },
  "spacing": { "unit": "4px", "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96, 144] },
  "radius": { "cup": "1.75rem", "control": "0.75rem", "pill": "999px" },
  "shadow": {
    "lift": "0 18px 30px -18px rgb(22 22 23 / 0.35), 0 2px 4px rgb(22 22 23 / 0.06)",
    "press": "0 4px 8px -4px rgb(22 22 23 / 0.3)"
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "quick": "140ms",
    "base": "240ms",
    "slow": "520ms"
  },
  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" }
}
